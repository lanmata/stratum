{
  "name": "front-backbone-rest",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-dev:win": "node server.js",
    "build": "ng build",
    "build:ssr": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "watch:ssr": "ng build --watch --configuration development",
    "dev": "concurrently \"pnpm run watch\" \"pnpm run serve:ssr\"",
    "serve:ssr": "node server.js",
    "serve:ssr:front-backbone-rest": "node dist/front-backbone-rest/server/server.mjs",
    "test": "ng test",
    "test:headless": "ng test --no-watch --browsers=ChromeHeadlessNoSandbox --code-coverage",
    "test:server": "node --test --experimental-test-coverage --test-coverage-include=\"server/**/*.js\" --test-coverage-exclude=\"server/test/**\" --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=85 \"server/test/*.test.js\"",
    "test:all": "pnpm run test:headless && pnpm run test:server"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.0.4",
    "@angular/ssr": "^22.0.4",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "compression": "^1.8.2",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "logform": "^2.7.0",
    "multer": "^2.4.0",
    "postcss": "^8.5.28",
    "proxy-addr": "^2.0.8",
    "redis": "^6.3.0",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.3",
    "toml": "^4.2.0",
    "tslib": "^2.8.1",
    "winston": "^3.19.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "toml": "^4.2.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
